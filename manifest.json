{
  "manifest_version": 3,
  "name": "BCA Retail Price Calculator",
  "version": "1.0",
  "description": "Scrapes retail price from BCA and helps calculate profit margin.",
  "permissions": [
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://*.bca.co.uk/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.bca.co.uk/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
